const zines = [{"title":"Send My Love to Maggie","subtitle":"","artist":"Mikayla Greenlund","affiliation":"Growing Greenlund","bio":"Mikayla is a garden designer and amateur herbalist who loves her community so much that she started a hyperlocal guerilla gardening group. Her efforts have brought attention to her old mining town's history with the cultivation of a Pocket Park neighboring the oldest gothic revival home in the US. She wrote this zine as a love letter to one particular tree on the front lawn of that house.","description":"\"The tree has been there as long as hometown residents can remember, and considering the age of the historic Partridge House (est 1829) we can only guess the age of the pink-flowering Magnolia on the front lawn.\" This is a love letter to a Magnolia seen at the entrance of our small town, Pottsville PA!","city":"Pottsville","state":"Pennsylvania","country":"United States","region":"Northeast","tags":["spirit","history"],"instagram":"@growinggreenlund; @commongroundcommunitygardeners","website":"","image":"tree zines masked/RTT_0034_send-my-love-to-maggie.png"},{"title":"Student Group Submission","subtitle":"Marist University","artist":"Marist University Student Group","affiliation":"Marist University","bio":"","description":"","city":"Poughkeepsie","state":"New York","country":"United States","region":"Northeast","tags":[],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"A Mini Guide to Winter Trees Common on River Walks in Maine","subtitle":"","artist":"Laura Grover","affiliation":"","bio":"Laura Grover, or just Grove (they/she), is a working-class queer artist, parent, educator and community member passionate about collaboration, mutual aid and reciprocity. In 2025, they became a Maine Master Naturalist and are so grateful to provide opportunities for people to connect with their animal-selves, and with one another, in the beautiful Wabanaki woods. Grove believes that connecting with the natural world empowers people to integrate into their ecology, strengthening values such as cooperation, community care, consent, and gratitude. A core tenant of their work is cultivating joy and curiosity, which Grove believes can lead to a better world.","description":"I am a Maine Master Naturalist and lead plant walks and queer ecology educational programming! This zine was inspired by a river walk in my town. I also love learning about trees in winter. 🧡","city":"Saco","state":"Maine","country":"United States","region":"Northeast","tags":["field"],"instagram":"@lgroverart","website":"https://friendzine.beehiiv.com","image":"tree zines masked/RTT_0037_a-mini-guide-to-winter-trees.png"},{"title":"A Tree Tour of King Zog's Trails","subtitle":"","artist":"Laura Erwin","affiliation":"Learn with Laura LI","bio":"Laura Erwin is a Long Island artist, game designer, and arts educator who has been doing environmental programming for libraries and museums.","description":"This Zine was inspired by travelling King Zog's trail in Muttontown Preserve. Long Island is pretty built up; it's rare to find such a forested and natural trail and hidden behind the trees are the ruins of Knollwood Estate. This zine looks at the local trees and history and graffiti art of King Zogs Ruins.","city":"West Hempstead","state":"New York","country":"United States","region":"Northeast","tags":["field"],"instagram":"","website":"https://www.ledg.fun; https://learnwithlaura.my.canva.site","image":"tree zines masked/placeholder.png"},{"title":"A Little Less Lonely","subtitle":"","artist":"Denise Hill","affiliation":"","bio":"I am a retired old lady with autism who enjoys spending more time with trees than people.","description":"A tree on my morning walk inspired the zine in combination with reading about the impact nature has on our wellbeing in the book Nature Fix as well as reading Robin Wall Kimmerer.","city":"Bay City","state":"Michigan","country":"United States","region":"Midwest","tags":["loneliness"],"instagram":"@putapotofwateron","website":"","image":"tree zines masked/RTT_0053_a-little-less-lonely.png"},{"title":"Copse and Sobbers","subtitle":"","artist":"Sandra Cox and Susan Kendrick","affiliation":"","bio":"We are a couple of middle-aged queer scholars who live and work in Southeast Missouri. Susan has been taking photographs, especially of flora and fauna, since she was an undergraduate, and Sandra studies comics as a medial literary form for her day job. Working together on this photo zine allowed them to bring their practices together and to memorialize someone important to them both.","description":"We love our local parks, and the memorial trees in Kiwanis became especially poignant after a particularly hard personal loss in 2023, so this zine is a teeny musing on how time and trees helped us cope with that bereavement and taught us to take comfort in the cyclical nature of our lovely regional arborvitae!","city":"Cape Girardeau","state":"Missouri","country":"United States","region":"Midwest","tags":["grief"],"instagram":"","website":"","image":"tree zines masked/RTT_0071_copse-and-sobbers.png"},{"title":"The Street Tree and the Scientist","subtitle":"","artist":"Natalie Love","affiliation":"Chicago Botanic Garden","bio":"I am a conservation scientist at the Chicago Botanic Garden and professor at Northwestern University. My work sits right at the intersection of urban forestry and tree conservation. I consider myself a certified tree nerd and I love walking around my city learning and wondering about the magnificent trees that make up our canopy. My favorite thing to do while traveling is learning the typical tree species planted along the streets in whatever city I visit, as well as bothering my friends for photos of street trees when they travel.","description":"This zine was inspired by my own research as a scientist at the Chicago Botanic Garden. I use a molecular approach to understand the genetic diversity and origin of Kentucky coffeetrees in Chicago's urban forest and whether they contribute to broader conservation efforts. The Kentucky coffeetree is threatened by extinction in the wild, but it is very commonly planted in urban forests around the world. In fact, it is now more abundant in urban forests than in the wild, which brings up intriguing consequences for conservation of the species. This is a drawing of the coffeetree that I walk past everyday on my way to the train station when commuting to the Garden, which is a female Kentucky coffeetree. For my research, I sampled leaves from 30 trees in the city, including this one that I walk by every day. I am so curious to learn her story and where she came from. The woman predicted in the zine is, of course, me, including me wearing my field overalls and collection fanny pack in the last scene.","city":"Chicago","state":"Illinois","country":"United States","region":"Midwest","tags":["science","introspective"],"instagram":"@nlr.love","website":"https://www.natalie-love.com","image":"tree zines masked/RTT_0038_the-street-tree-and-the-scientist.png"},{"title":"This Oak’s No Joke","subtitle":"A Guide to Different Oaks in Chicago","artist":"Vicky Bolanos","affiliation":"","bio":"Vicky Bolanos (he/they) is an artist living in the Uptown neighborhood of Chicago. He hopes you care for and are cared for by others.","description":"This is a collection of Oak trees that really can be found a lot of the US, but we do have a ton in Chicago and I wanted to highlight that. Oaks are very important to urban/rural wildlife, providing food and shade for many creatures!","city":"Chicago","state":"Illinois","country":"United States","region":"Midwest","tags":["field"],"instagram":"@vicortreat","website":"","image":"tree zines masked/RTT_0039_this-oaks-no-joke.png"},{"title":"Free Trees","subtitle":"","artist":"Beth Nelson","affiliation":"Earth & Company","bio":"I’m Beth Nelson, creator of Earth & Company. I am a nature-based preschool teacher with a love of all things place-based native plants and ecosystems.","description":"When we moved to this house there were no trees here. Randomly, over a few years, I received two free trees to plant in my yard.","city":"Holland","state":"Michigan","country":"United States","region":"Midwest","tags":["backyard"],"instagram":"@earth_and_company","website":"","image":"tree zines masked/RTT_0051_free-trees.png"},{"title":"Oaks","subtitle":"A Love Note, An Obsession","artist":"Erin Frances Wasinger","affiliation":"","bio":"Erin Frances is a certified Michigan Master Naturalist, and part-time elementary school librarian. She’s lived in Lansing, Michigan, for the last 13 years and only regrets it from early November to late March. She’s the author of zines, memoir comics, and other offline art creations.","description":"Ever since I read Douglas Tallamy’s book “How Can I Help?” (about ecology) I’ve been obsessed with the idea of growing an oak tree of my own. Oaks are native but not common where I live because they grow slowly and people dislike the mess. But they’re superstars!","city":"Lansing","state":"Michigan","country":"United States","region":"Midwest","tags":["spirit"],"instagram":"@somewonderland","website":"https://somewonderland.itch.io","image":"tree zines masked/RTT_0052_oaks-a-love-note.png"},{"title":"Ginkgo Trees of Lexington, Kentucky","subtitle":"","artist":"Ben Drake","affiliation":"","bio":"I am an artist, illustrator, and teacher.","description":"There is a popular street in my city where the trees all change a bright yellow every November and your zine idea prompted me to learn more about the trees that are planted there.","city":"Lexington","state":"Kentucky","country":"United States","region":"Midwest","tags":["spirit"],"instagram":"@bentheredrakethat","website":"","image":"tree zines masked/placeholder.png"},{"title":"The Scenic Oak on Scenic Road","subtitle":"","artist":"Julie Savage","affiliation":"","bio":"Neuroscientist for money, visual artist (ceramics, watercolor, sketch, fiber arts) for living","description":"Do you know those huge oak trees that have a 'backyard tree,' vibe? My neighbors have one on their front lawn.","city":"Rocky River","state":"Ohio","country":"United States","region":"Midwest","tags":["analog"],"instagram":"@tinysavagesketches","website":"","image":"tree zines masked/placeholder.png"},{"title":"Aspens Are Wonderful Creatures","subtitle":"","artist":"Willa Heil","affiliation":"","bio":"Willa is a lover of all things nature, but trees have always been special because they feel like friends. She is currently pursuing a BFA in Comic Arts at Minneapolis College of Art and Design, and hopes to build a career in publishing and graphic novels once she graduates! In her free time, Willa loves to hike, rollerblade, and collect interesting rocks and sticks.","description":"The two most beloved trees in my states are golden yellow. Having lived in Santa Fe, NM, for most of my life, I've experienced the color change of the aspens on the Sangre de Cristo Mountains every year and it is truly transformative. The rustling of the leaves and the golden color is all encompassing, and they're both a huge tourism draw and an precious experience for locals every year. You have to keep an eye on the mountains in September/October to catch the change at it's peak, and then everyone goes up there all at once! I kind of thought this special love for trees was unique to my hometown, but then I moved to Minneapolis, MN, and discovered the ginkgo trees are equally beloved! Over the school year, I table at art local markets and one of my sticker designs is a ginkgo leaf. 8/10 times someone stops at my booth, they make a comment about how much their mom/brother/cousin would love this sticker, and sometimes they buy it as a gift! It has been so eye-opening to realize how each city holds a tree close to our collective hearts, and it makes me excited to discover why Minneapolis loves ginkgos the longer I live here!","city":"Santa Fe / Minneapolis","state":"New Mexico / Minnesota","country":"United States","region":"Midwest","tags":["feast","introspective","aspen"],"instagram":"@wch.art","website":"https://wchart.myportfolio.com/work","image":"tree zines masked/RTT_0059_aspens-are-wonderful-creatures.png"},{"title":"Trees of Missouri","subtitle":"","artist":"Hadley Josse","affiliation":"","bio":"I am a multi-disciplined artist that is currently going to school for graphic communications. My 3 favorite things are my dog, yoga, and doing murals.","description":"My Two Dimensional Design teacher gave us an option to make a zine for Hyper Local or do another project and I loved the idea of a zine vending machine! I really enjoyed getting up close and personal with the trees on campus. I noticed things I wouldn't have noticed otherwise.","city":"St. Louis","state":"Missouri","country":"United States","region":"Midwest","tags":["photo"],"instagram":"@hadleyhadz","website":"","image":"tree zines masked/RTT_0070_trees-of-missouri.png"},{"title":"Bark of MacGroveland, St. Paul, Minnesota","subtitle":"","artist":"Piper Christensen","affiliation":"","bio":"I'm a painter, illustrator and tree appreciator from Minneapolis.","description":"This zine documents bark from trees I saw walking to and from school every day. It can be used as an identification guide, but these paintings are also portraits. I encourage readers to admire the patterns and landscapes in the bark of their local trees!","city":"Twin Cities","state":"Minnesota","country":"United States","region":"Midwest","tags":["feast"],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"Can You Love a Tree?","subtitle":"","artist":"Tricia Lane-Forster","affiliation":"","bio":"I am an artist (printmaker, fibers), a writer, and an adaptive art teacher from Baltimore, Maryland. I love gardening, my cats, road trips with my son and trees! *I've been making zines since high school (I graduated in 1993).","description":"I came across your Instagram and I had a lot of old work about trees I've loved and I made new work for this zine too. I decided to start with my earliest memories of trees, then a tree I miss, then 2 trees that are in my current yard and finally a print of a tree from my childhood home.","city":"Baltimore","state":"Maryland","country":"United States","region":"South","tags":["analog","nostalgia","collage"],"instagram":"@tlaneforster; @adaptedarttlf","website":"https://tlaneforster.blogspot.com; https://mimosapicnic.etsy.com","image":"tree zines masked/RTT_0035_can-you-love-a-tree.png"},{"title":"The Second Oldest Tree in Texas","subtitle":"","artist":"Marie Ketring","affiliation":"","bio":"I am an alternative process photographer interested in how people navigate the natural world. My recent projects include hand tinted tourist postcards and a long-form project about the Texas Anthrax Triangle. I prefer imperfect artwork that shows the evidence of human hands.","description":"Texas has a lot of \"Famous\" or rather \"Infamous\" trees. I have an old book about them. There is, however, a very charming small town in Texas that holds the \"Second Oldest Tree in Texas\". This appeals to me in that it is a celebration of almost making it. Second place. I've photographed this tree a few times and this 'zine is part of a larger gallery show to be finished next Spring.","city":"Buda","state":"Texas","country":"United States","region":"South","tags":["photo"],"instagram":"@marieketring","website":"","image":"tree zines masked/placeholder.png"},{"title":"Love Letter to 9 Woods","subtitle":"","artist":"Amy Jane Williams","affiliation":"Amy Williams Wellness","bio":"Amy Jane Williams has loved trees since childhood - and continues to take action to save them by advocating with City Council, increasing awareness of declining tree canopies, and planting more trees. A licensed mental health therapist, Amy includes nature in her mental health practice and cares deeply about all beings - especially trees!","description":"The devastation of so many trees being cut down inspired this zine. I worked to save a local woods that the City Council voted to clear cut. So I held a service where 30 people, including The Charlotte Observer, came. I am still working to save plants before it is clear cut next year. I hope you will find my submission worthy to include. If I need to change anything or send original via snail mail, let me know. Thank you for offering this.","city":"Charlotte","state":"North Carolina","country":"United States","region":"South","tags":["analog"],"instagram":"","website":"https://www.amywilliamswellness.com","image":"tree zines masked/RTT_0049_love-letter-to-9-woods.png"},{"title":"Memories in the Branches","subtitle":"","artist":"Lauro L. & Clover","affiliation":"inkYhilo","bio":"Lauro is a Charlottesville based artist who works under the name inkYhilo making prints, zines and other handmade things. They also make collaborative zines with their partner Clover.","description":"This zine is a record of some of the trees that standout in my memory from growing up along the Rockfish River. Though there are something’s that get lost with time, there will always be parts that remain.","city":"Charlottesville","state":"Virginia","country":"United States","region":"South","tags":["nostalgia","introspective"],"instagram":"@inkyhilo","website":"","image":"tree zines masked/RTT_0085_memories-in-the-branches.png"},{"title":"Japanese Magnolias Like It Hot","subtitle":"","artist":"Joy M. Garretson","affiliation":"","bio":"I have done little drawings for years and recently started making small zines for myself and my friends. I have a daughter and a ridiculous dog. I love going into the woods and going on adventures, and I do these things as much as possible (but not nearly enough). I think that life is weird and beautiful, if you know what to look at.","description":"I have a Japanese Magnolia in my (new-ish) front yard. It's one of my favorite trees, and I have only had access to them via neighbors or public spaes. So, to have this tree in my front yard is a new source of","city":"Clayton","state":"North Carolina","country":"United States","region":"South","tags":["backyard"],"instagram":"","website":"","image":"tree zines masked/RTT_0044_japanese-magnolias-like-it-hot.png"},{"title":"All Around the Mulberry Trees of Durham","subtitle":"","artist":"Barbara Berry","affiliation":"","bio":"Barbara is an community artist and teen librarian. She is constantly inspired by the beauty of the natural world, random craft projects, live music and books of course.","description":"Mulberry trees are all over the yards across the cityscape of Durham. I know they are ready for picking when you see bright noticeable marks on the ground and hear the busy activity of birds and other animals eating the purple berries.","city":"Durham","state":"North Carolina","country":"United States","region":"South","tags":["analog","spirit"],"instagram":"","website":"","image":"tree zines masked/RTT_0046_all-around-the-mulberry-trees-of-durham.png"},{"title":"Untitled","subtitle":"","artist":"Time Markello","affiliation":"Poorly Illustrated","bio":"I make Poorly Illustrated comics about music and things.","description":"This is a tree in my yard so I guess it’s my tree. Can you own a tree? seems silly when the tree is way older than me.","city":"Galveston","state":"Texas","country":"United States","region":"South","tags":["comic"],"instagram":"","website":"https://poorlyillustrated.com","image":"tree zines masked/RTT_0041_untitled---fort-collins.png"},{"title":"The Tree Tunnel","subtitle":"","artist":"Amy Lee","affiliation":"","bio":"I'm an illustrator working primarily with digitized tools. I'm a traditional fine artist, using paints, inks, pencils, water media, and pastels. I work from my iPad in the Procreate app.","description":"There's a tree tunnel along the Rice University campus, near my home. It is gorgeous, and peaceful, and mysterious. Houston gets very hot during the summers, and the shady tunnel is welcome relief for both drivers and pedestrians.","city":"Houston","state":"Texas","country":"United States","region":"South","tags":["feast"],"instagram":"@amyannlee.archive","website":"","image":"tree zines masked/RTT_0063_the-tree-tunnel.png"},{"title":"Pink Snow","subtitle":"","artist":"Mike Short","affiliation":"","bio":"Mike Short is an Eisner and Harvey nominated cartoonist and illustrator living in Lorton, Virginia.","description":"I've always loved trees and when I saw the call for zines I was immediately inspired to tell the story of the cherry tree in my front yard.","city":"Lorton","state":"Virginia","country":"United States","region":"South","tags":["comic","spirit"],"instagram":"@mikeshort42","website":"https://backintheshed.com","image":"tree zines masked/RTT_0081_pink-snow.png"},{"title":"Forest Pansy Redbuds of Virginia","subtitle":"","artist":"Pamela Gray Willcox","affiliation":"Graymatters Design & Publishing","bio":"I’m Pamela Gray Willcox, an artist, children’s book author and illustrator, and the founder of Graymatters Design & Publishing. With a background in visual communications and a lifelong love of storytelling, I’m drawn to the little details that make the world extraordinary. Living in Virginia's Blue Ridge Mountains has given me endless opportunities to observe the natural world just outside my door. Through art, stories, and now zines, I love sharing those discoveries and reminding others that sometimes the most meaningful stories begin when we slow down and notice.","description":"My inspiration for this zine came from the two Forest Pansy Redbud trees in my front yard. Their changing colors first caught my attention, but when one stopped blooming, I started looking more closely at its struggle to survive. Its companion seemed to lean toward it as if to say, “Hang in there, buddy.” Having faced my own cancer journey, I felt a special connection to this struggling tree and refused to give up on it. This is a story about hope, patience, and the bond we can feel with nature when we take the time to notice.","city":"Massanutten","state":"Virginia","country":"United States","region":"South","tags":["grief","illness","introspective"],"instagram":"@pswillcox1996","website":"https://www.graymattersdesignpublishing.com; https://graymattersdesign.wixsite.com/portfolio","image":"tree zines masked/placeholder.png"},{"title":"The Protector Norway Spruce","subtitle":"","artist":"Pamela Gray Willcox","affiliation":"Graymatters Design & Publishing","bio":"I’m Pamela Gray Willcox, an artist, children’s book author and illustrator, and the founder of Graymatters Design & Publishing. With a background in visual communications and a lifelong love of storytelling, I’m drawn to the little details that make the world extraordinary. Living in Virginia's Blue Ridge Mountains has given me endless opportunities to observe the natural world just outside my door. Through art, stories, and now zines, I love sharing those discoveries and reminding others that sometimes the most meaningful stories begin when we slow down and notice.","description":"As a children's book author and illustrator, I was inspired by my favorite tree, a towering Norway spruce I call The Protector. I began noticing not only its quiet beauty, but also the shelter it provides for the deer and other creatures who share our forest. The zine also reflects my belief that a garden can be created in harmony with nature, enhancing the landscape without replacing what was already there. It is a small story about looking more closely at the world around us and discovering that observation is an act of love.","city":"Massanutten","state":"Virginia","country":"United States","region":"South","tags":["backyard"],"instagram":"@pswillcox1996","website":"https://www.graymattersdesignpublishing.com; https://graymattersdesign.wixsite.com/portfolio","image":"tree zines masked/RTT_0084_the-protector-norway-spruce.png"},{"title":"My Favorite Local Oak: Past and Future","subtitle":"","artist":"Lanelle Jansen van Vuuren","affiliation":"Untypicality Reclaimed","bio":"Lanelle (she/they) is a queer disabled creative and coach who recently moved to Raleigh, NC from the UK. Untypicality Reclaimed is her catch all for play, care and creativity. They create and share playful and inclusive art, solo journaling TTRPGs, zines and more.","description":"Having recently moved to NC from the UK, I am in a place of immersing myself in my new local community. One of the main ways I'm doing that is in getting to know my new local natural environment and the flora and fauna in it. This call for zines was the perfect opportunity to reflect on that in a meaningful way, thank you.","city":"Raleigh","state":"North Carolina","country":"United States","region":"South","tags":["timetraveler","spirit","introspective"],"instagram":"@untypicality.reclaimed","website":"","image":"tree zines masked/RTT_0047_my-favorite-local-oak-tree.png"},{"title":"Trees of Roanoke","subtitle":"","artist":"NCS Student","affiliation":"North Cross School","bio":"Student at North Cross School in Roanoke, VA","description":"Nature journaling and my neighborhood","city":"Roanoke","state":"Virginia","country":"United States","region":"South","tags":["analog"],"instagram":"","website":"","image":"tree zines masked/RTT_0082_trees-of-roanoke.png"},{"title":"Leaf","subtitle":"","artist":"Barbara Spieth","affiliation":"","bio":"I have been an artist my whole life. I dapple in multiple art forms and enjoy learning new things.","description":"I grew up in the trees. The leaf I used was from a baby spout that I let grow from a neighbor's tree. It is now a grown, beautiful shady tree. This is the largest leaf so far.","city":"San Antonio","state":"Texas","country":"United States","region":"South","tags":["imprint"],"instagram":"","website":"","image":"tree zines masked/RTT_0028_leafing-through-bogata.png"},{"title":"Oak","subtitle":"","artist":"Laura J. Bill","affiliation":"Laura J. Bill Art","bio":"I am multidisciplinary artist living in Tryon, NC, working primarily in printmaking, woodcarving and painting. I enjoy being spontaneously inspired and use a variety of modalities to bring my creative vision to life.","description":"\"Oak\" is about a majestically huge and dramatically rotten tree that almost crushed my car on my birthday. It's still standing, which is both admirable and concerning. Because of that, it is noticeable compared to the other trees, and a natural subject for a zine.","city":"Tryon","state":"North Carolina","country":"United States","region":"South","tags":["imprint"],"instagram":"@laurabillart","website":"https://laurabillart.com","image":"tree zines masked/RTT_0052_oaks-a-love-note.png"},{"title":"Untitled","subtitle":"","artist":"Claudia Davis","affiliation":"","bio":"Claudia Davis is a nature and tree enthusiast who has lived in Washington DC for over 6 years. During the day she works in environmental policy to protect what she loves but her free time goes to enjoying and capturing the natural world through drawing and printmaking.","description":"I submitted one other zine I had already made about me and a tree in DC but when I saw this prompt I knew I wanted to create a new zine with this collection in mind! DC is a beautiful city full of awesome people with no federal representation and now the President and Congress have made it their mission to further weaken our self determination-this even extends to the fate of our trees!! The title of the zine is a nod to Free DC, our amazing local organization fighting to defend DC's Home Rule and hopefully one day facilitate full statehood for the district.","city":"Washington","state":"District of Columbia","country":"United States","region":"South","tags":["backyard"],"instagram":"","website":"","image":"tree zines masked/RTT_0041_untitled---fort-collins.png"},{"title":"Tree DC","subtitle":"","artist":"Claudia Davis","affiliation":"","bio":"Claudia Davis is a nature and tree enthusiast who has lived in Washington DC for over 6 years. During the day she works in environmental policy to protect what she loves but her free time goes to enjoying and capturing the natural world through drawing and printmaking.","description":"The view out my DC window! DC is full of trees that I get to enjoy from the ground when I walk, bike, and bus around the city but I experience them completely differently from the fourth floor. And sometimes they're evasive.","city":"Washington","state":"District of Columbia","country":"United States","region":"South","tags":[],"instagram":"","website":"","image":"tree zines masked/RTT_0080_tree-DC.png"},{"title":"The Big Ass Douglas Fir","subtitle":"","artist":"Kathryn Turner","affiliation":"Frivolous Forest Artworks","bio":"I'm Kate Turner, a mixed media artist who lives north of Seattle. I love doing art about nature and politics. I grew up around the world, and I am a fervent naturalist who loves the living world.","description":"a special tree in my yard","city":"Brier","state":"Washington","country":"United States","region":"West","tags":["backyard","analog"],"instagram":"@frivolousforestartworks","website":"","image":"tree zines masked/placeholder.png"},{"title":"Place - Time - Jacaranda","subtitle":"","artist":"Chiu-Ki Chan","affiliation":"Travel Zines by Chiuki","bio":"Chiu-Ki Chan loves to travel, and she loves to write down the unexpected delights along the way, illustrated with fun drawings. She has been scanning and printing her travel journals for her family and friends, and decided to publish them as zines so more people can enjoy them.","description":"I fell in love with the jacaranda tree as a kid, and the zine explores how my relationship with it evolved as I moved from Hong Kong to California to Colorado.","city":"Erie","state":"Colorado","country":"United States","region":"West","tags":["timetraveler","map"],"instagram":"","website":"https://travelzines.store","image":"tree zines masked/RTT_0040_place---time---jacaranda.png"},{"title":"Untitled","subtitle":"","artist":"Patrick Mead","affiliation":"","bio":"Artist and teacher who likes to look at trees illuminated by streetlights. Trying to find my ecological niche.","description":"The empty lot between apartments where weeds are given a chance. Knowing the names of trees you pass by so you can greet them as your friend.","city":"Fort Collins","state":"Colorado","country":"United States","region":"West","tags":["photo"],"instagram":"@patrick.meat","website":"","image":"tree zines masked/RTT_0041_untitled---fort-collins.png"},{"title":"Kite Thief","subtitle":"A Tree in Glassellland","artist":"Joseph X Casillas","affiliation":"Gladlyinsane","bio":"I'm a writer/director in Los Angeles, California. I am a grad school dropout (English Studies-Creative Writing). I founded Gladlyinsane, a sketch comedy skit-thing that's been making videos for over 15 years. I've been published in Northridge Review, Big Table Press and more. Some of my photography was recently featured in 'Scenes from the Underground' hosted by Reckless Magazine.","description":"At the beginning of the year (January 2026) I wanted to do a Tree Survey for fun - documenting each tree in the park across the street from my house. So I polished the dust off of my old film camera and bought a roll for the first time since 2016 and went through the park for a few hours with my camera and a little pocket-sized notebook. It was actually a lot more playful than I intended. I thought up stories and funny (made-up) tidbits about the trees in the park anyhow they got there / how old they were / etc., My submission - Kite Thief - is just one of the trees I surveyed that day (turned into the zine with the format you provided on your website). Essentially, it's a small portion of a much bigger collection. It was also conducted at a very difficult time in my life. I had just decided to drop out of grad school and the person I had grown close to for months had suddenly disappeared. Making that Tree Survey, and consequently this zine, was a creative outlet for me. Thank you for your time!","city":"Glassell Park","state":"California","country":"United States","region":"West","tags":["narrative"],"instagram":"","website":"https://gladlyinsane.com/case-files-2/","image":"tree zines masked/RTT_0055_kite-thief.png"},{"title":"Douglas Fir","subtitle":"","artist":"Katherine Derbyshire","affiliation":"Beyond the Wave","bio":"I write fiction and non-fiction inspired by the beauty of the Pacific Northwest.","description":"Inspired by a stand of Douglas fir at a small park near me.","city":"Kenmore","state":"Washington","country":"United States","region":"West","tags":["educational"],"instagram":"","website":"","image":"tree zines masked/RTT_0077_big-ass-douglas-fir.png"},{"title":"Trees of Lazy Mountain","subtitle":"","artist":"Kristin Knight Pace","affiliation":"Arctic Tern Press","bio":"I’m Kristin Knight Pace - an Alaskan author, mom, pilot, and founder of a literary press.","description":"We’ve often wondered about the origin story of our frontyard tree. This zine gave me the opportunity to illustrate our wondering.","city":"Palmer","state":"Alaska","country":"United States","region":"West","tags":["introspective"],"instagram":"","website":"https://www.arcticternpress.com","image":"tree zines masked/RTT_0058_trees-of-lazy-mountain.png"},{"title":"Requiem for a Tree","subtitle":"","artist":"Amy Stewart","affiliation":"","bio":"I'm the author of THE TREE COLLECTORS and 15 other books. I'm also an artist, and I've worked in oil, watercolor, acrylic, gouache, and ink for 25 years. I coordinate the Portland Urban Sketchers group and draw in my sketchbook almost every day.","description":"After painting the trees on my street for several years, I documented a massive cedar being cut down and replaced. It was heartbreaking to see it go. I wrote an essay about it called Requiem for a Tree, which I published in my newsletter on Substack. I consider this zine to be a companion piece to the essay.","city":"Portland","state":"Oregon","country":"United States","region":"West","tags":["feast","narrative","spirit"],"instagram":"@amystewart","website":"https://www.amystewart.com","image":"tree zines masked/RTT_0062_requiem-for-a-tree.png"},{"title":"Stuff Trees of Portland","subtitle":"","artist":"Elle Skinner","affiliation":"","bio":"Elle is a comic maker and nature artist based in Portland, OR. When not making art she can be found hiking around her city, drinking coffee, and chasing after new and exciting bird calls","description":"I recently moved to Portland and walking around this town I have been amazed at the ways people use the trees around them to express themselves. Each tree takes on a character and personality through these interactions with humans that encourages me, in turn, to stop and interact with my environment more","city":"Portland","state":"Oregon","country":"United States","region":"West","tags":["spirit","field"],"instagram":"","website":"https://art.mysky.net","image":"tree zines masked/placeholder.png"},{"title":"Mad Squirrels, Frost Beard, and Trees That Go Shhh in the Night","subtitle":"Observations from a PNW Suburb","artist":"Julie Holetz","affiliation":"","bio":"Three facts about me : I learned Spanish to watch Spanish movies without subtitles, I am learning to draw to make art about my favorite things, this is my second finished zine.","description":"The trees in my neighborhood have so many stories to tell. The closer you look, the more they reveal - each day offers a new tale. I am excited to share some of my observations and invite others to pause and ponder the trees around them.","city":"Redmond","state":"Washington","country":"United States","region":"West","tags":["map","spirit"],"instagram":"@skamama","website":"","image":"tree zines masked/RTT_0074_mad-squirrels-frost-beard.png"},{"title":"Untitled","subtitle":"","artist":"Zoe Bray","affiliation":"","bio":"I'm an aspiring illustrator, especially focused on drawing trees, and children playing around them.","description":"my love of trees and of zines!","city":"Reno","state":"Nevada","country":"United States","region":"West","tags":["analog"],"instagram":"@zbrayillustrations","website":"","image":"tree zines masked/RTT_0041_untitled---fort-collins.png"},{"title":"How to Identify and Use the Magnolia","subtitle":"","artist":"Elijah Bennett","affiliation":"PUPWORKZ","bio":"PUPWORKZ is a zine- and sticker-maker based out of Sacramento, CA. Many of his zines focus on foraging, plant and fungi identification, and the beauty of interacting with nature.","description":"\"Magnolias\" features a full spread of information about how to identify, forage, and use (both culinarily and medicinally) the ancient Magnolia tree. It also notes fun facts and ancient traditions surrounding this amazing tree.","city":"Sacramento","state":"California","country":"United States","region":"West","tags":["educational"],"instagram":"@pupworkz","website":"","image":"tree zines masked/RTT_0054_how-to-identify-and-use-magnolia.png"},{"title":"Are You a Tree?","subtitle":"","artist":"Joanne Warden and Pete Warden","affiliation":"","bio":"We are an artist and and engineer living with two small dogs.","description":"Joanne came home after a walk in love with this tree, but was disappointed when she discovered that botanically it wasn’t even a tree. We dove into the subject together, and realized that there’s a quality of treeness that everyone recognizes, but which is hard to define, and definitely isn’t captured by scientific classifications. This zine is about some of the different ways we all read trees, and how we read the world.","city":"San Francisco","state":"California","country":"United States","region":"West","tags":["philosophical","introspective"],"instagram":"","website":"","image":"tree zines masked/RTT_0056_are-you-a-tree.png"},{"title":"Alder St Walnut Tree","subtitle":"","artist":"Jaden Manjarrez","affiliation":"Luv Letter Studios","bio":"Jaden Manjarrez (He/Him) is a queer zine-maker based in Seattle, WA better known as luv letter studios. He makes zines that challenge, celebrate, and acknowledges the deep complexity to love and it's many form.","description":"This zine is about a walnut tree that was in the backyard of my childhood home and it's relationship with me as a kid.","city":"Seattle","state":"Washington","country":"United States","region":"West","tags":["memory"],"instagram":"@luvletterstudios","website":"","image":"tree zines masked/RTT_0079_alder-st-walnut-tree.png"},{"title":"Oh, Beautiful Palm Tree","subtitle":"","artist":"Tiffany Guevara","affiliation":"","bio":"My name is Tiffany Guevara! I am a first-generation Colombian-American painter, illustrator, and small business owner living in Southern California. I run TiffymLuv; I made this business to share whimsical and uplifting artwork, spreading joy and warmth to everyone who encounters it! My artwork blends cute East Asian-style artwork with Western impressionist influences based on my experience living abroad in places such as Japan, South Korea, different parts of the U.S., and Colombia. Through my time living in diverse communities, my work aims to capture the beauty of nature and the precious little moments of life.","description":"My zine is inspired by the lovely large and beautiful palm trees here in my local city of Westminster. I have grown up always close to the beach and no matter where I am there is usually palm trees nearby the beach coasts. This palm tree in particular is special to me because its leaves are so long they reach down towards the sidewalks. I used to walk my late dog by this tree all the time and it was his favorite sniffing spot. Now, every time I pass this particular palm tree on my walks, I think of my dog and I miss him so much. The leaves feel like they are reaching out to me grabbing my hand, and I feel less alone and sad. I sometimes give this tree a hug when I walk by as it reminds me of my late grandma and late aunt, who would feel more energized after huging trees (any trees for her would do). I thought of many trees I wanted to talk about and draw but I felt the most loved by the palm tree as of lately so I wanted to dedicate my mini zine to it, as it felt right and hyperlocal to me and my heart.","city":"Westminster","state":"California","country":"United States","region":"West","tags":["poem"],"instagram":"@tiffymluv","website":"https://tiffymluv.wixsite.com/porfolio","image":"tree zines masked/RTT_0057_oh-beautiful-palm-tree.png"},{"title":"Wormy’s Mysterious Tree","subtitle":"","artist":"Tiffany Y. Rondón Román","affiliation":"Doki Doki Kokoro","bio":"Hii my name is Tiffany Rondón, a puerto rican librarian and artist. I love stationery, journaling, craft and of course read!","description":"I may not know a lot of tree names but I sure love watching trees and relaxing with them. When I saw this opportunity I knew I had to talk about at least two of the most beloved trees of Puerto Rico: the Flamboyán and the Maga tree / Maga Flower. The first tree is a stamp in many puerto rican's gardens and they are simply so stunning and inspiring to look at. I decided to go with the yellow version since its quire rare (usually is red/orange) which allowed me to also mention a lovely, well-known puerto rican children book about the tree. Lastly, I had to bring homenage to our native tree The Maga Tree, named related to the their blossoms which there are also maga flowers. For this, I used my original character Wormy , a bookworm that finds an eaten maga flower and book and sets out to find the mysterious tree from which the flower came from. In his journey, he finds another worm; a pink worm that in real life eats Maga trees and other cotton trees; which helps Wormy find the tree and the flowers. While I know that your collection is meant for US based tress, it would be an honor for our little zine to be part of series Reading the trees.","city":"Bayamón","state":"Puerto Rico","country":"Puerto Rico","region":"U.S. territory","tags":["narrative"],"instagram":"@doki.doki.kokoro.store; @pegatinasclub","website":"","image":"tree zines masked/placeholder.png"},{"title":"Devrai","subtitle":"The Sacred Groves of Maharashtra","artist":"Anuradha Joshi","affiliation":"","bio":"Anuradha Joshi is intensely fascinated by animals and insects. She’s currently pursuing her PhD on aquatic invertebrates in Canada. She has been to many places and sometimes wonders what to call home. At times like these she turns to creativity. She wishes to keep writing and illustrating for both science and fiction to spread the word about the beauty of the natural world.","description":"Last year in the scorching Indian summer, I and my research partner were travelling down the western coast of India for fieldwork. One day we reached the edge of a sacred grove communicated to us by contacts from an NGO. Since then I have felt like more people need to find out about places like these; hence, I immediately thought of making a zine on them in connection to 'Reading the Trees' series! Sacred groves are a trove for old-world trees, sometimes even endemic to each grove. It is a tree phenomenon that needs to be protected.","city":"","state":"Maharashtra","country":"India","region":"Asia","tags":["educational","spirit"],"instagram":"@a.nu.beginning","website":"https://anufolio.carrd.co","image":"tree zines masked/RTT_0020_devrai.png"},{"title":"Pear Tree","subtitle":"","artist":"Sarah Evans","affiliation":"Maristem Garden","bio":"I am a Master gardener, restauranteur and chef. I've been making zines since the 90s and have been documenting my garden with zines and videos.","description":"We grow a garden behind our restaurant and inn, and every year I am amazed by the pear trees. They produce so much fruit and feed us and our garden in so many ways. I saw your call on Instagram and thought of these beautiful trees right away.","city":"Sackville","state":"New Brunswick","country":"Canada","region":"Canada","tags":["analog","narrative"],"instagram":"","website":"","image":"tree zines masked/RTT_0030_pear-tree.png"},{"title":"How About Them Apples?","subtitle":"","artist":"Laura Wesley","affiliation":"","bio":"Mature student expanding their mind with an MA in Anthropology. Former corporate communications crank turned creative freelancer.","description":"This zine was inspired by an assignment in my Anthropology program called \"Theorizing the Apple\" in which students apply what they are learning by making art. One of the tenants of Anthropology is to make the strange familiar, and the familiar strange. What is more familiar to me than an apple?","city":"Sainte-Cecile-de-Masham","state":"Quebec","country":"Canada","region":"Canada","tags":["educational"],"instagram":"","website":"https://www.laurawesley.ca","image":"tree zines masked/RTT_0031_how-about-them-apples.png"},{"title":"A Mini Zine About a Schoolyard Tree, Childhood Friends, and Growing Up","subtitle":"","artist":"Cindy Long","affiliation":"","bio":"Cindy is a queer and racialized TV editor based in Toronto, Canada. She has too many hobbies, including but not limited to circus aerials, playing the viola, and paddling in the backcountry.","description":"My zine is inspired by a specific tree in my elementary school yard that my friends and I would climb every day after school. As we got older, more and more branches were removed, until it became no longer climbable. The evolution of this tree mirrors what it feels like to have friendships change as we grow up.","city":"Toronto","state":"Ontario","country":"Canada","region":"Canada","tags":["memory","introspective"],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"Making Willow Charcoal","subtitle":"","artist":"Sarah Lawson","affiliation":"","bio":"Sarah Lawson was born in Toronto. She is an artist with a Masters degree in Forest Conservation. Sarah uses resistance, stitching, sketching and photography to explore and illuminate the natural world, the urban landscape, and her roles as a woman, caregiver and adventurer.","description":"I love trees and making my own art supplies. This is a zine about making willow charcoal from huge willows in my neighbourhood. Making charcoal is a fun activity for kids and adults, artists and naturalists.","city":"Toronto","state":"Ontario","country":"Canada","region":"Canada","tags":["educational"],"instagram":"@sarahlawsontoronto","website":"https://sarahlawson.ca","image":"tree zines masked/RTT_0033_making-willow-charcoal.png"},{"title":"Untitled","subtitle":"","artist":"Shikha Nambiar","affiliation":"Sunny Skies Starry Eyes","bio":"Shikha is a multidisciplinary artist from India, currently based in Santiago, Chile. She has a deep interest in the history of people and places and likes to document her findings through art. Her art is also inspired by quiet days, cats & everyday moments.","description":"I’ve always been in love with the gorgeous Gulmohar tree, as it’s called in India, where I’m from. Summer means streets lined with these trees in full glory, bursting into brilliant shades of red. This zine is an ode to one of my favourite trees!","city":"Santiago","state":"Santiago Metropolitan Region","country":"Chile","region":"Latin America","tags":["introspective"],"instagram":"@chicabeingme","website":"","image":"tree zines masked/RTT_0041_untitled---fort-collins.png"},{"title":"Leafing Through Bogotá","subtitle":"","artist":"María Alejandra Martínez Polanco","affiliation":"Animamundi.co","bio":"I always find it difficult to describe myself. I studied chemistry and completed a master’s degree. Later, I decided to explore other fields and took a course in illustration. I truly enjoy writing, learning new things, and engaging in outdoor sports, such as yoga, hiking or climbing. I have a bird illustration brand for T-shirts. At heart, I am simply a soul exploring itself within a human body.","description":"The fanzine was born out of my obsession with Bogotá. It is the city where I was born and where I currently live; however, I haven’t resided here the entire time. I have lived in other cities, and with each return, I make new discoveries. For the past few years, my goal has been to get to know this chaotic city better and better, and -Leafing through Bogotá- is an excellent excuse to do just that.","city":"Bogotá","state":"Bogotá Capital District","country":"Colombia","region":"Latin America","tags":["spirit","educational","map"],"instagram":"@animamundi.co","website":"","image":"tree zines masked/placeholder.png"},{"title":"Student Group Submission","subtitle":"Centro Universitario Anglo Mexicano - Cancún","artist":"CUAM Cancún Student Group","affiliation":"Centro Universitario Anglo Mexicano (CUAM) Cancún","bio":"","description":"","city":"Cancún","state":"Quintana Roo","country":"Mexico","region":"Latin America","tags":[],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"Roots","subtitle":"Common Trees of Czechia","artist":"Ville Klapuch Nevalainen","affiliation":"","bio":"Ville is an Finnish illustrator and writer based in Czechia. His work is inspired by nature and the small details of everyday life. Through illustration, he loves sharing the stories of trees, birds, and the habitats around us.","description":"Through hand-drawn illustrations and short observations, the zine explores what trees can tell us about my place (Czechia) from their leaves and seeds to the wildlife they shelter. It invites readers to slow down, look closer, and discover why common trees are never boring.","city":"Prague","state":"Czech Republic","country":"Czech Republic","region":"Europe","tags":["educational"],"instagram":"@ville_illustrator","website":"","image":"tree zines masked/RTT_0016_roots-and-hope.png"},{"title":"Trees with Eyes","subtitle":"","artist":"Barbara Schunk","affiliation":"","bio":"I’ve been drawing and illustrating for as long as I can remember, mostly for fun, with occasional small commissions along the way. Over the past few years, I’ve been putting more time and energy into it, and I love seeing where my creativity takes me. As a chemist and science journalist, I’m now exploring ways to bring science and illustration together.","description":"The tree with eyes stands along the path from my home to the beach, and I often walk, jog, or cycle past it. When I first noticed the eyes, I thought someone had carved them into the bark. Then I did a little research and found out they were natural. But I like the idea that they’re real eyes best of all. So sometimes I wink at the tree. And maybe it winks back.","city":"Copenhagen","state":"Capital Region of Denmark","country":"Denmark","region":"Europe","tags":["introspective"],"instagram":"@kunsthuhn","website":"","image":"tree zines masked/RTT_0017_trees-with-eyes.png"},{"title":"Roots & Hope","subtitle":"","artist":"No Roziere-Endo","affiliation":"","bio":"I'm a queer, neurodivergent french-japanese illustrator and aspiring comic artist. I'm passionate about social justice, food, and I really love cats (I just want to hug all of them, but I can't, can't hug every cat)","description":"I journal a lot and I've noticed hopelessness being the dominant subject since I went back to work. So recently I've been making a conscious effort to take note of things around me to find inspiration and a little bit of joy. This zine is a few bits and pieces from my personal journal and cleaned up sketches of my favorite trees.","city":"Jarnac","state":"Charente","country":"France","region":"Europe","tags":["introspective"],"instagram":"@sadbluen","website":"","image":"tree zines masked/placeholder.png"},{"title":"In Memory of a Tree","subtitle":"","artist":"Claude Wear","affiliation":"","bio":"I am a mix media artist originally from Hong Kong, now living in Paris.","description":"Growing up in HK where the city slowly ate up the natural landscape, whilst simultaneously being capable of continuously growing diverse vegetation.","city":"Paris","state":"Île-de-France","country":"France","region":"Europe","tags":["memory","feast"],"instagram":"@alumpofrice","website":"","image":"tree zines masked/RTT_0014_in-memory-of-a-tree.png"},{"title":"On Trees and Possession","subtitle":"","artist":"Anna Vanco","affiliation":"","bio":"Anna Vanco is a french poet, writer and freelance journalist. Her writing explores linguistics, narratology, and how humans handle the unknown and the intangible.","description":"Watching the tree outside my balcony led me to a conversation on possession, linguistics and traditions ! I tried to touch on all of that through out those 8 pages :) This tree is part of my every day life and yet this prompt has led me to see it in a new light, so thank you for that opportunity !","city":"Toulouse","state":"Haute-Garonne","country":"France","region":"Europe","tags":["philosophical","backyard"],"instagram":"@vanco.jpeg","website":"","image":"tree zines masked/RTT_0012_on-trees-and-possession.png"},{"title":"Trees I’ve Hugged and Where in Berlin to Find Them","subtitle":"","artist":"Ami Bogin","affiliation":"","bio":"Ami Bogin is a Kalmyk American artist currently based in Berlin. Her work explores the folk, environmental, and decolonial confluences of history and personal story. And she has, embarrassingly, hugged many trees around the world.","description":"I had not heard of Hyperlocal before the open call and I find the mission statement so perfectly up my street! As we get closer to tech dystopia, I am finding so much healing and mindful renewal in getting into what is hyperlocal for myself here in Berlin (or wherever I may find myself) and what positivity these stories of connection and presence can bring to people.","city":"Berlin","state":"Berlin","country":"Germany","region":"Europe","tags":["comic","spirit"],"instagram":"@abanimates","website":"https://auilix.com","image":"tree zines masked/placeholder.png"},{"title":"Oh My Dear Pear","subtitle":"","artist":"Giulia Sassoli","affiliation":"","bio":"I'm not an artist; I'm a scientist. I like monkeys, movement, and sleeping in nature. I believe in the importance of experiencing and respecting nature","description":"It's about a recent time where I had the chance to spend my days with my friends and partner, people I love and who loved me. Even though I felt as if I had only just entered adulthood, now, looking back, I feel as if I'm reliving childhood memories.","city":"Rome","state":"Lazio","country":"Italy","region":"Europe","tags":["memory"],"instagram":"@giuliasassoli","website":"","image":"tree zines masked/RTT_0015_oh-my-dear-pear.png"},{"title":"The Fairies of Urban Trees","subtitle":"","artist":"Marit Jansen","affiliation":"","bio":"My name's Marit (she/her, queer, from The Netherlands), I'm a 23 year old maker exploring themes such as trees, nature, ordinary life, my love for physical media through zines, visual diaries, experiments, lino prints. I'm a fourth year illustration student, but only calling myself an illustrator feels too small for all the ideas I have. I just make whatever I want to make!","description":"The combination of one of my favorite trees nearby (in park De Oude Plantage) and having read a book about folk- and fairytales got me inspired to make a whimsical zine about the magic of trees! For me, the magic of trees is also about things as the wood wide web, research into trees having memories, etc. I would like to invite people to take a closer look and be more appreciative of trees, and with this zine I do it by introducing a little magic :)","city":"Rotterdam","state":"South Holland","country":"Netherlands","region":"Europe","tags":["introspective"],"instagram":"@mbm.arts","website":"","image":"tree zines masked/placeholder.png"},{"title":"Chinese Windmill Palm Tree","subtitle":"","artist":"Hannah Moshtael","affiliation":"Hannah Moshtael Illustration","bio":"I am an illustrator based in Oxford, UK, who is a world citizen with family and community connections ranging from creative Glasgow, to the sunny Isle of Wight and Iran. My work is inspired by the Teachings of Bahá'u'lláh, Who called for peace, justice and unity, stating: \"Let your vision be world embracing...\"","description":"The Chinese Windmill Palm is a cheerful tree that brightens up my garden year-round in the urban Oxford neighbourhood of Blackbird Leys, UK. I wanted to share this as there are not many of these particular trees around here, but this one has grown up to the height of our roof and has made itself very much at home. Blackbird Leys is a large high-density social housing estate built in the 1950s and 60s, that is culturally diverse, has a friendly community spirit and some pleasant green parks.","city":"Oxford","state":"England","country":"United Kingdom","region":"Europe","tags":["analog"],"instagram":"@hannahmoshtael","website":"https://www.hannahmoshtael.com","image":"tree zines masked/RTT_0019_chinese-windmill-palm-tree.png"},{"title":"My Favorite Hyperlocal Tree in the Fall","subtitle":"","artist":"Alvril Valova Fransen","affiliation":"Ecoffordance SITP Team, Tongji University","bio":"I'm a student in Shanghai, and experiencing the four seasons for the first time made me love trees even more! I really really like the sounds, not to mention the visuals! So many feelings!","description":"I've always loved how the trees in my university were so grand and could protect me from the shade, I also loved the sounds the leaves make whenever fall comes around! So I wanted to make a minizine for you guys about one particular tree I always see everyday.","city":"Shanghai","state":"Shanghai","country":"China","region":"Asia","tags":["introspective"],"instagram":"","website":"","image":"tree zines masked/RTT_0026_my-favorite-hyperlocal-tree.png"},{"title":"Trees Indoors","subtitle":"Nature for the Chronically Ill","artist":"Ayushi Singh","affiliation":"","bio":"Hey, i am Ayushi aka Ashy. I am a queer artist and designer based in India. I usually spend most of my time making art and sitting with my cat.","description":"just my love for the trees and the value they hold","city":"Bangalore","state":"Karnataka","country":"India","region":"Asia","tags":["introspective","backyard"],"instagram":"@boigender","website":"","image":"tree zines masked/RTT_0022_trees-indoors.png"},{"title":"Trees of Bangalore","subtitle":"An Untold Tale of India’s Silicon Valley","artist":"Noopur Varma","affiliation":"","bio":"I am a Design consultant and Educator based out of Bangalore. I love print as medium even though I primarily work with digital technologies. I love to work at the cross of culture, design and policy. Talk to me about open technologies and design.","description":"The zine is about Bangalore, the city known for IT infrastructure but my personal connection and love with the trees of this city.","city":"Bangalore","state":"Karnataka","country":"India","region":"Asia","tags":["spirit"],"instagram":"","website":"","image":"tree zines masked/RTT_0023_trees-of-bangalore-silicon-valley.png"},{"title":"The Curious Case of Chandigarh’s Autumn and Spring Phenomenon","subtitle":"","artist":"Armaan Rai","affiliation":"","bio":"Armaan Rai is an Indian queer poet and writer. She has a degree in psychology which has failed to satisfy her creative itch. So, she is now teaching herself how to paint.","description":"The zine is about a unique phenomenon that takes place in spring every year in Chandigarh. While the entire city blooms in colors of spring, autumnal colors also appear in certain pockets because some of the trees that have been planted by the planners shed their leaves in Indian spring. This leads to some very interesting visuals and experiences.","city":"Chandigarh","state":"Chandigarh","country":"India","region":"Asia","tags":["spirit","analog"],"instagram":"@oreganooranges","website":"","image":"tree zines masked/RTT_0024_the-curious-case-of-chandigarhs.png"},{"title":"Trees from My Garden and from My City Nagpur","subtitle":"","artist":"Shomira / Chikoobee","affiliation":"","bio":"Shomira is an illustrator, whose passions inform her creative and artistic pursuits. Her interests lie in social and environmental issues, and she follows a hand-drawn/painted style for her illustrations on these themes and more. Previously, she has made illustrations for various organisations, with her work featuring in different forums and publications as well.","description":"I was inspired to showcase some local trees that are not only found in my city/region, but also in my home. I have been lucky to grow up around so much greenery, with several trees of varied kinds, housing all sorts of animals, bird, and insects! As a participant from India, I wanted to showcase trees that are also not necessarily commonly found in other parts of the world - mostly in the Indian subcontinent, and something that others may be unfamiliar with, but would learn something new about. My zine is packed with quick facts, flavour, and a personal touch for each of the trees/plants showcased.","city":"Nagpur","state":"Maharashtra","country":"India","region":"Asia","tags":["analog","spirit","field"],"instagram":"@chikoobee","website":"https://tinyurl.com/ChikoobeePortfolio","image":"tree zines masked/RTT_0025_trees-from-my-garden-and-from-my-city-nagpur.png"},{"title":"In My Memory, a Tree Called to Me","subtitle":"","artist":"Fatimah Nadeem","affiliation":"Fatimah Creates","bio":"Fatimah Nadeem is an artist and illustrator based in Karachi, Pakistan, known for her vibrant color palettes and magically rich worlds. Her work often explores the stories between people, animals, and the natural world — celebrating comfort, whimsy, and quiet joy. Her art has appeared in magazines, children’s books, stationery and apparel collections around the world. Beyond commissions, she continues to develop her own narrative ideas that focus on wonder and exploring one’s imagination. When she’s not illustrating, she’s hanging out with her cat, Coco, planning her next nature adventure, and creating fun content for her Instagram blog.","description":"This zine is inspired by a Lignum tree that grew by my childhood home for as long as I can remember. It had to be felled because it's roots were too far under the building and were uprooting the structure. I spent a lot of time observing the seasonal flowers, wrens that hid within it's branches, beautiful raindrops that collected in it's leaves, growing up. For my final year project for my Fine Arts degree in 2022, I spent months researching and collecting photos of Lignum trees as part of my process, my thesis project revolved around this same concept. Loosing a tree I had grown up with and trying to immortalize it's memory through my art. This short poem and visual is inspired by my story, and is a mix of hand-painted elements such as the background, raindrops and flowers along with digital elements of the tree and text.","city":"Karachi","state":"Sindh","country":"Pakistan","region":"Asia","tags":["poem","feast"],"instagram":"@fatimah.creates","website":"","image":"tree zines masked/RTT_0021_in-my-memory-a-tree-called-to-me.png"},{"title":"Give Me a Home Amongst the Gum Trees","subtitle":"Flora and Fauna of Victoria, Australia","artist":"Sasha Oskorep","affiliation":"Lil Bean Zine","bio":"I am Sasha Skore part of Lil Bean Zines. I’m trying to make music, support mental health, the environment, and share creativity and connection through zines. Kathleen, my other half, is Conservation Sprout, deeply passionate about sustainability, environmental science, media, and fashion.","description":"This zine is inspired by my partner and I’s love for trees, the environment, and our local Australian native plant and wildlife. Varied eucalyptus trees feature as they are an iconic, essential, and admirable group of trees. I also wanted to celebrate the range of environments and ecosystems attached to these trees, particularly the animals who depend on them (including us), and live very close to our homes in suburbs and the city. I reflected on both broader habitat and personal perspectives. I love flying foxes / bats and know the relationships between all animals and trees are important!","city":"Melbourne","state":"Victoria","country":"Australia","region":"Australia","tags":["spirit","collage","field"],"instagram":"@lilbeanzine","website":"","image":"tree zines masked/RTT_0009_give-me-a-home-amongst-the-gum-trees.png"},{"title":"Rainbow Beach, Queensland, Australia","subtitle":"","artist":"Kathryn Pope","affiliation":"","bio":"I am an avid nature sketcher and enjoy looking at things in a different way. I love Australia's native species and experiment with ways to capture their personality.","description":"I felt I needed to decolonise a place I was walking around, by renaming the streets after the native trees which grew there.","city":"Rainbow Beach","state":"Queensland","country":"Australia","region":"Australia","tags":["analog"],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"Southern Live Oaks of Savannah","subtitle":"","artist":"Rosemary Dodson","affiliation":"","bio":"I am a high school art teacher at Savannah Arts Academy. I love to draw and paint and have incorporated zines into my drawing curriculum for years. When I'm not teaching, I love to go on adventures and travel with my family.","description":"The zine is themed around facts about Southern Live Oak trees and their connection to famous locations and trees around town.","city":"Savannah","state":"Georgia","country":"United States","region":"South","tags":["analog","spirit"],"instagram":"","website":"","image":"tree zines masked/RTT_0069_southern-live-oaks-of-savannah.png"},{"title":"Southern Live Oaks","subtitle":"Trees of Savannah, Georgia","artist":"Seven Roden","affiliation":"","bio":"My name is Seven and I'm a comic artist and illustrator! My passion is science education and explaining information by combining text and visuals. I love to research and learn about almost anything, especially if its related to earth science!","description":"Living in Savannah, GA, I'm surrounded by beautiful, historic, trees that inspire me everyday, I knew they would be the perfect subject for this zine!","city":"Savannah","state":"Georgia","country":"United States","region":"South","tags":["educational","comic"],"instagram":"@pigeonsnacks","website":"https://sevenroden.wixsite.com/portfolio","image":"tree zines masked/RTT_0069_southern-live-oaks-of-savannah.png"},{"title":"Not From Around Here","subtitle":"How Seattle Shaped and Was Shaped by Mutant Trees from the Deep South","artist":"K. L. Graywill","affiliation":"Hyperlocal Dispatch","bio":"","description":"","city":"Seattle","state":"Washington","country":"United States","region":"West","tags":["introspective","educational","spirit","history"],"instagram":"","website":"","image":"tree zines masked/RTT_0078_not-from-around-here.png"},{"title":"How a University In the Forest Shaped the Urban Canopy of a City","subtitle":"Willow Oaks & The History of Durham and Duke","artist":"K. L. Graywill","affiliation":"Hyperlocal Dispatch","bio":"","description":"","city":"Durham","state":"North Carolina","country":"United States","region":"South","tags":["history","educational","spirit","field","map"],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"Unincorporated Tree Towns of the Foothills","subtitle":"","artist":"K. L. Graywill","affiliation":"Hyperlocal Dispatch","bio":"","description":"","city":"Conifer","state":"Colorado","country":"United States","region":"West","tags":["history","educational","field","map"],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"My Fig'ing Tree","subtitle":"","artist":"Karine Rupp-Stanko","affiliation":"","bio":"","description":"","city":"Asheville","state":"North Carolina","country":"United States","region":"South","tags":["introspective","collage","analog"],"instagram":"","website":"","image":"tree zines masked/placeholder.png"},{"title":"Street Trees of Seattle","subtitle":"","artist":"Taha Ebrahimi","affiliation":"","bio":"","description":"","city":"Seattle","state":"Washington","country":"United States","region":"West","tags":["field","spirit","history","educational"],"instagram":"","website":"","image":"tree zines masked/RTT_0076_street-trees-of-seattle.png"},{"title":"Trees of Raleigh","subtitle":"","artist":"Lauren Blanch","affiliation":"The Bike Library","bio":"","description":"","city":"Raleigh","state":"North Carolina","country":"United States","region":"South","tags":["field","spirit","educational"],"instagram":"","website":"","image":"tree zines masked/RTT_0048_trees-of-raleigh.png"}];
